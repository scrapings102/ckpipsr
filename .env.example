# The public site. Copy to .env and fill in. The dev server will not start
# without these, so every port is set here and nowhere in the code.

# The port the site runs on. Must be in CORS_ORIGINS in backend/server/.env,
# and VITE_SITE_URL in backend/admin/.env must point at it.
SITE_PORT=3000

# Where /api is proxied in development: the admin API (backend/server), on
# the PORT set in backend/server/.env.
VITE_API_PROXY_TARGET=http://localhost:4000

# Where /chatbot-api is proxied in development: the site assistant's own
# service (chatbot/backend), on the PORT set in chatbot/backend/.env. The widget always
# calls the same-origin path, so nothing changes in production — the proxy or
# the web server points that path at the service instead.
VITE_CHATBOT_PROXY_TARGET=http://localhost:5006

# Not read by the site. The LLM key belongs to chatbot/backend/.env, where it
# stays on the server; see chatbot/backend/.env.example. Anything Vite is meant
# to expose to the browser has to start with VITE_, so a key named like this
# would not be bundled — but it does not belong here either.
GEMINI_API_KEY=
